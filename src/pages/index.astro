---
import BaseLayout from "../layouts/BaseLayout.astro";
import TermField from "../components/home/TermField.astro";
import { SITE, NAV } from "../config";
import { DISTILLATIONS } from "../data/distillations";
import { FRAGMENTS } from "../data/fragments";
import { SYSTEMS } from "../data/systems";

const written = SYSTEMS.filter((s) => s.status === "written");
const fragment = FRAGMENTS[0];
const system = written[0] ?? SYSTEMS[0];
---

<BaseLayout path="/">
  <section class="hero" data-hero>
    <div class="wrap hero-content">
      <div class="hero-grid">
        <div class="hero-main">
          <p class="label label-ember hero-kicker reveal">{SITE.philosophy}</p>
          <h1 class="display hero-title reveal">Fire,<br /><em>distilled.</em></h1>
        </div>
        <div class="hero-side reveal">
          <p class="hero-statement">{SITE.tagline}</p>
        </div>
      </div>
    </div>

    <div class="wrap hero-foot reveal" data-hero-foot>
      <div class="thesis">
        <p class="label thesis-label">Current thesis</p>
        <p class="thesis-line">
          <span class="thesis-lead">{SITE.thesisLead}</span>
          <span class="thesis-main">{SITE.thesis}</span>
        </p>
      </div>

      <div class="field-tools">
        <div class="field-controls">
          <span class="label field-state is-distilled" data-state>Structured</span>
          <button class="control" type="button" data-distill hidden>
            <span data-distill-label>Distill</span>
            <svg viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path
                d="M2 4.5 6 8.5 10 4.5"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>
            </svg>
          </button>
        </div>
        <p class="field-caption label" data-caption>
          Complexity, on purpose → structure, on demand
        </p>
      </div>
    </div>

    <TermField />
  </section>

  <section class="areas">
    <div class="wrap">
      <p class="label section-label">What's here</p>
      <ol class="index-list">
        {
          NAV.map((item) => (
            <li class="index-item reveal">
              <a href={item.href}>
                <span class="index-name">{item.label}</span>
                <span class="index-note">{item.note}</span>
                <svg class="index-arrow" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                  <path
                    d="M5 12h14M13 6l6 6-6 6"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="recent">
    <div class="wrap recent-grid">
      <div class="recent-col">
        <p class="label section-label">Recently distilled</p>
        {
          DISTILLATIONS.slice(-2)
            .reverse()
            .map((d) => (
              <a class="recent-item reveal" href={`/distillations/${d.slug}/`}>
                <h3 class="recent-title">{d.title}</h3>
                <p class="recent-body">{d.oneSentence}</p>
                <p class="label recent-meta">
                  {d.fields.join(" · ")} — {d.readingTime}
                </p>
              </a>
            ))
        }
      </div>

      <div class="recent-col">
        <p class="label section-label">From the notebook</p>
        <a class="recent-item reveal" href={`/fragments/#${fragment.id}`}>
          <h3 class="recent-title">{fragment.title}</h3>
          <p class="recent-body">{fragment.body[0]}</p>
          <p class="label recent-meta">fragment · {fragment.date}</p>
        </a>
        <a class="recent-item reveal" href={system.href ?? "#"}>
          <h3 class="recent-title">{system.name}</h3>
          <p class="recent-body">{system.oneLiner}</p>
          <p class="label recent-meta">system · {system.domains.join(" · ")}</p>
        </a>
      </div>
    </div>

    <div class="wrap close">
      <p class="close-line display">
        Not a portfolio. A laboratory — I learn things, then explain them.
      </p>
      <a class="link close-link" href="/distillations/">Start with a distillation</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── hero: a full screen of dark, and the field ─────────────────────── */
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    padding-top: clamp(2rem, 6vh, 4rem);
    padding-bottom: 1.25rem;
    overflow: hidden;
  }
  .hero-content {
    position: relative;
    z-index: 3;
    margin-bottom: clamp(2.25rem, 8vh, 5.5rem);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: end;
  }
  .hero-side {
    border-left: 1px solid var(--line);
    padding-left: clamp(1rem, 2.5vw, 2rem);
    padding-bottom: 0.4rem;
  }
  .hero-kicker {
    margin-bottom: clamp(0.8rem, 2.2vh, 1.6rem);
  }
  .hero-title {
    font-size: clamp(2.6rem, min(10vw, 14vh), 11rem);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: -0.045em;
    line-height: 0.98;
  }
  .hero-title em {
    font-style: normal;
    font-weight: 300;
    text-transform: lowercase;
    letter-spacing: -0.03em;
    color: var(--bone);
    display: inline-block;
    margin-left: clamp(0.75rem, 7vw, 6rem);
  }
  .hero-statement {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: min(clamp(1rem, 1.5vw, 1.35rem), 2.1vh);
    line-height: 1.45;
    color: var(--ash);
    max-width: 36ch;
  }

  .hero-foot {
    position: relative;
    z-index: 3;
    margin-top: 0;
    padding-top: 0;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2.5rem;
    flex-wrap: wrap;
  }
  .thesis-label {
    margin-bottom: 0.6rem;
  }
  .thesis-line {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: min(clamp(1rem, 1.7vw, 1.3rem), 2vh);
    line-height: 1.4;
    max-width: 54ch;
  }
  .thesis-lead {
    color: var(--smoke);
  }
  .thesis-main {
    color: var(--bone);
  }

  .field-tools {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.6rem;
  }
  .field-controls {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .field-state {
    transition: color 0.4s var(--ease);
  }
  .field-state.is-distilled {
    color: var(--ember);
  }
  .field-caption {
    font-size: 0.62rem;
    text-align: right;
  }

  /* ── areas index ────────────────────────────────────────────────────── */
  .areas {
    margin-top: clamp(5rem, 12vw, 9rem);
  }
  .section-label {
    margin-bottom: 1.75rem;
  }
  .index-list {
    padding-block: 0.5rem;
  }
  .index-item a {
    display: grid;
    grid-template-columns: minmax(9rem, 14rem) 1fr auto;
    align-items: baseline;
    gap: 1.5rem;
    padding-block: clamp(1.4rem, 3.4vw, 2.1rem);
    transition: padding-left 0.4s var(--ease);
  }
  .index-item a:hover {
    padding-left: 0.75rem;
  }
  .index-name {
    font-size: clamp(1.25rem, 2.6vw, 1.75rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--ash);
    transition: color 0.3s var(--ease);
  }
  .index-note {
    color: var(--smoke);
    font-size: 0.98rem;
  }
  .index-arrow {
    color: var(--smoke);
    align-self: center;
    transition: color 0.3s var(--ease), transform 0.4s var(--ease);
  }
  .index-item a:hover .index-name {
    color: var(--bone);
  }
  .index-item a:hover .index-arrow {
    color: var(--ember);
    transform: translateX(4px);
  }

  /* ── recent ─────────────────────────────────────────────────────────── */
  .recent {
    margin-top: clamp(5rem, 12vw, 9rem);
  }
  .recent-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(2rem, 6vw, 5rem);
  }
  .recent-col .section-label {
    margin-bottom: 0.5rem;
  }
  .recent-item {
    display: block;
    padding-block: clamp(1.2rem, 3vw, 1.9rem);
  }
  .recent-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.35rem, 2.4vw, 1.7rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
    transition: color 0.3s var(--ease);
  }
  .recent-item:hover .recent-title {
    color: var(--ember);
  }
  .recent-body {
    margin-top: 0.6rem;
    color: var(--ash);
    font-size: 1rem;
    max-width: 52ch;
  }
  .recent-meta {
    margin-top: 0.9rem;
  }

  /* ── close ──────────────────────────────────────────────────────────── */
  .close {
    margin-top: clamp(5rem, 11vw, 8rem);
    padding-top: 0;
  }
  .close-line {
    font-size: clamp(1.35rem, 2.8vw, 2rem);
    font-weight: 400;
    max-width: 44ch;
    color: var(--ash);
  }
  .close-link {
    display: inline-block;
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ember);
  }
  .close-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (max-width: 820px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .hero-side {
      border-left: none;
      border-top: 1px solid var(--line);
      padding-left: 0;
      padding-top: 1rem;
    }
    .recent-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .index-item a {
      grid-template-columns: 1fr auto;
    }
    .index-note {
      grid-column: 1 / -1;
      grid-row: 2;
      font-size: 0.9rem;
    }
    .field-tools {
      align-items: flex-start;
    }
    .field-caption {
      text-align: left;
    }
  }
</style>
