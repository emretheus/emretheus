---
import BaseLayout from "../layouts/BaseLayout.astro";
import { FIRE } from "../data/fire";
import { DISTILLATIONS } from "../data/distillations";
import { FRAGMENTS } from "../data/fragments";
import { SYSTEMS } from "../data/systems";

const latest = DISTILLATIONS[0];
const system = SYSTEMS[0];
const fragment = FRAGMENTS[0];
---

<BaseLayout
  title="Fire — Emretheus"
  description="What's in the fire right now: the latest distillation, a system case study, a note — and the experiments that haven't been distilled yet."
  path="/fire/"
>
  <header class="page-head">
    <div class="wrap">
      <p class="label label-ember reveal">Fire</p>
      <h1 class="display page-title reveal">What's in the fire right now.</h1>
      <p class="page-lead reveal">
        Experiments live here: things I'm testing, reading and thinking about.
        When one matures, it leaves this page and becomes a distillation.
      </p>
    </div>
  </header>

  <section class="wrap sec">
    <p class="label section-label">Featured</p>
    <div class="featured">
      <a class="feat reveal" href={`/distillations/${latest.slug}/`}>
        <span class="label feat-kind">Latest distillation</span>
        <h2 class="feat-title">{latest.title}</h2>
        <p class="feat-line">{latest.oneSentence}</p>
      </a>
      <a class="feat reveal" href={system.href ?? "/systems/"}>
        <span class="label feat-kind">System</span>
        <h2 class="feat-title">{system.name}</h2>
        <p class="feat-line">{system.oneLiner}</p>
      </a>
      <a class="feat reveal" href={`/fragments/#${fragment.id}`}>
        <span class="label feat-kind">Note</span>
        <h2 class="feat-title">{fragment.title}</h2>
        <p class="feat-line">{fragment.body[0]}</p>
      </a>
    </div>
  </section>

  <section class="wrap sec">
    <p class="label section-label">Experiments</p>
    <ol class="exp-list">
      {
        FIRE.map((e) => (
          <li class="exp reveal">
            <div class="exp-head">
              <span class="label exp-status">{e.status}</span>
              <h2 class="exp-title">{e.title}</h2>
            </div>
            <p class="exp-line">{e.line}</p>
            <p class="exp-foot label">
              {e.becomes ? `When it matures → ${e.becomes}` : "No distillation planned yet"}
              {e.href && (
                <>
                  {" · "}
                  <a class="exp-link" href={e.href}>
                    related distillation ↗
                  </a>
                </>
              )}
            </p>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>

<style>
  .page-head {
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
    padding-bottom: clamp(2rem, 5vw, 3.5rem);
  }
  .page-title {
    margin-top: 1rem;
    font-size: clamp(2rem, 5.5vw, 4rem);
    font-weight: 600;
    letter-spacing: -0.045em;
    max-width: 26ch;
    line-height: 1.02;
  }
  .page-lead {
    margin-top: 1.25rem;
    color: var(--ash);
    max-width: 58ch;
    font-size: 1.06rem;
  }

  .sec {
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
  }
  .section-label {
    margin-bottom: 1.25rem;
  }

  .featured {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .feat {
    background: var(--bg-2);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    transition: background 0.3s var(--ease);
  }
  .feat:hover {
    background: var(--bg-3);
  }
  .feat-kind {
    color: var(--smoke);
  }
  .feat-title {
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .feat:hover .feat-title {
    color: var(--ember);
  }
  .feat-line {
    color: var(--ash);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .exp-list {
    display: grid;
    gap: clamp(1.75rem, 4vw, 2.75rem);
  }
  .exp {
    max-width: 64ch;
  }
  .exp-head {
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }
  .exp-status {
    color: var(--ember);
  }
  .exp-title {
    font-size: clamp(1.2rem, 2.2vw, 1.5rem);
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .exp-line {
    margin-top: 0.6rem;
    color: var(--ash);
    font-size: 1.02rem;
    line-height: 1.65;
  }
  .exp-foot {
    margin-top: 0.75rem;
    color: var(--smoke);
  }
  .exp-link {
    color: var(--ash);
  }
  .exp-link:hover {
    color: var(--ember);
  }

  @media (max-width: 820px) {
    .featured {
      grid-template-columns: 1fr;
    }
  }
</style>
