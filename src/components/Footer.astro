---
import { SITE, NAV, SOCIALS } from "../config";
import Mark from "./Mark.astro";

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap">
    <div class="foot-top">
      <div class="foot-brand">
        <p class="foot-wordmark">
          <Mark size={13} />
          <span>Emretheus</span>
        </p>
        <p class="foot-philosophy">{SITE.philosophy}</p>
      </div>

      <nav class="foot-col" aria-label="Areas">
        <p class="label">Areas</p>
        <ul>
          {
            NAV.map((item) => (
              <li>
                <a class="foot-link" href={item.href}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="foot-col">
        <p class="label">Elsewhere</p>
        <ul>
          {
            SOCIALS.map((s) => (
              <li>
                <a
                  class="foot-link"
                  href={s.href}
                  rel="noopener noreferrer"
                  target={s.href.startsWith("mailto:") ? undefined : "_blank"}
                >
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="foot-bottom">
      <span class="label">© {year} {SITE.fullName}</span>
      <span class="label">Berlin · {SITE.location.split(",")[1]?.trim() ?? ""}</span>
      <span class="label">Visit counts only: no cookies, no trackers</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: clamp(6rem, 12vw, 10rem);
    padding-block: clamp(2.5rem, 5vw, 4rem) 1.5rem;
  }

  .foot-top {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: 2.5rem;
  }

  .foot-wordmark {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .foot-philosophy {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.35rem;
    line-height: 1.35;
    color: var(--ash);
    max-width: 24ch;
  }

  .foot-col ul {
    margin-top: 1rem;
    display: grid;
    gap: 0.45rem;
  }
  .foot-link {
    font-size: 0.95rem;
    color: var(--ash);
    transition: color 0.25s var(--ease);
  }
  .foot-link:hover {
    color: var(--ember);
  }

  .foot-bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    justify-content: space-between;
    margin-top: 3.5rem;
  }

  @media (max-width: 740px) {
    .foot-top {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
    .foot-brand {
      grid-column: 1 / -1;
    }
  }
</style>
